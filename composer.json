{
    "name": "pitea/modularity-a-o",
    "description": "Modularity A-Ö Links module for Piteå",
    "type": "wordpress-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Piteå kommun"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "autoload": {
        "psr-4": {
            "ModularityAOLinks\\": "source/php/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "autoloader-suffix": "ModularityAOLinksPlugin",
        "allow-plugins": {
            "composer/installers": true
        },
        "sort-packages": true
    }
}
